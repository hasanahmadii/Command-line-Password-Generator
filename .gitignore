# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*

# Test, coverage, and tooling output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter generated state
.ipynb_checkpoints/

# Local databases and SQLite sidecar files (may contain passwords)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# IDE and operating-system files
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
